{
  "name": "s2script",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "s2script monorepo — an s2script workspace: npm workspaces cover packages/* (types + CLI) and the base-plugin tree. Base plugins ship in the runtime zip and are not published to npm.",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "plugins/disabled/*"
  ],
  "s2script": {
    "workspace": {
      "plugins": [
        "plugins/*",
        "plugins/disabled/*"
      ]
    }
  },
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s2script/s2script.git"
  }
}
