// DO NOT EDIT THIS FILE. It ships with s2script and an upgrade OVERWRITES it — any change
// you make here is lost on the next update. To fix or add an entry on a live server, drop a
// .jsonc file in gamedata/sdkhooks/custom/ instead: it is applied last, replaces whole named
// entries, needs no rebuild, and survives upgrades. See docs/INSTALL.md ("Hot-fixing a
// broken signature").
//
// ONE EXCEPTION TO "REPLACES WHOLE NAMED ENTRIES": a signature's `validate` block. If your
// custom/ entry supplies a pattern but no `validate`, the SHIPPED validator is CARRIED FORWARD
// onto it and the boot banner says so. To disarm the gate, write `"validate": {}` explicitly.
//
// Owner: sdkhooks — first-party SDKHooks virtuals (wiki type names: Touch, Spawn, Think, Use, …).
// Target: CS2 — "game": "csgo". Every signature below scans CS2's libserver.so.
//
// Keys are wiki type names (Touch, not CBaseEntity_Touch). Pre/Post twins share one signature.
// The class for the RTTI gate is `validate.vtable-member`. Do NOT ship a borrowed vtable slot
// as `offsets` — the boot resolver derives the slot from the unique signature + vtable walk
// and prints `gamedata OK Touch (slot N)`.
//
// Patterns: unique subclass OVERRIDE prologues from source2rosetta `rosetta-cs2.json`
// (version cs2-25000182-0, source_build 25000182, core tier, validated:true). The base
// CBaseEntity::{StartTouch,Touch,EndTouch,Spawn} records in that dump are offset-only
// (147 / 148 / 149 / 10) — HINTS, never shipped. Unique-scan + vtable-member at boot
// against OUR libserver.so is the gate (docs/re-strategy.md). A missing or failed row
// skips without boot FAIL; SDKHook returns false for that type.
//
// VScript is dead in CS2. Rosetta's `CBaseEntity::DispatchTraceAttack` `name-contradicted`
// (VScript registry → ScriptTrigger) is not an identity check. DTA stays in gamedata/core/.
//
// Still empty (no ABI-matching unique linux prologue in that dump): Spawn, Think, PreThink,
// Use, GetMaxHealth, ShouldCollide, VPhysicsUpdate, GroundEntChangedPost, CanBeAutobalanced,
// Reload, WeaponCanUse, WeaponCanSwitchTo, WeaponDrop, WeaponEquip, WeaponSwitch.
// OnTakeDamageAlive / TraceAttack / FireBulletsPost have no distinct CS2 function yet (OnTakeDamage
// + OnTakeDamagePost stay on the existing DispatchTraceAttack mux in gamedata/core/).
// Do not substitute CBaseEntity::SetGroundEntity for GroundEntChangedPost (that is the setter).
// CTriggerTeleport::Touch is the teleport body (measured 6 int / 4 float, prototype mismatch)
// — not the Touch virtual.
{
  "signatures": {
    // CBaseTrigger StartTouch override. Base CBaseEntity::StartTouch is offset-only (147).
    // Prologue uniqueness is the `call [rax+0x870]` (another virtual on `this`); slot 0x870
    // may drift — missing match degrades this type, never a crash. vtable-member is the
    // TRIGGER class: the override address is not a slot of CBaseEntity's primary vtable.
    "StartTouch": {
      "linuxsteamrt64": {
        "module": "libserver.so",
        "pattern": "55 48 89 E5 41 56 41 55 49 89 F5 41 54 53 48 89 FB 48 83 EC 10 48 8B 07 FF 90 70 08 00 00",
        "resolve": "direct",
        "validate": { "vtable-member": "CBaseTrigger" }
      }
    },
    // CTriggerPush Touch override. Same ABI as CBaseEntity::Touch (this, other). Rosetta's
    // CBaseEntity::Touch prototype lists this (CTriggerPush*, CBaseEntity*) overload; the
    // base record itself is offset-only (148).
    "Touch": {
      "linuxsteamrt64": {
        "module": "libserver.so",
        "pattern": "55 48 89 E5 41 57 41 56 41 55 49 89 F5 41 54 53 48 89 FB 48 83 EC 58",
        "resolve": "direct",
        "validate": { "vtable-member": "CTriggerPush" }
      }
    },
    // CBaseTrigger EndTouch override. Base CBaseEntity::EndTouch is offset-low-conf (149 @ 58%)
    // in Rosetta and not emitted; CTriggerBrush::EndTouch is offset-only (149) — HINT.
    "EndTouch": {
      "linuxsteamrt64": {
        "module": "libserver.so",
        "pattern": "55 BA FF FF FF FF 48 89 E5 41 57 41 56 41 55 49 89 F5",
        "resolve": "direct",
        "validate": { "vtable-member": "CBaseTrigger" }
      }
    },
    // CFuncPlat::Blocked — unique linux prologue + "%s Blocked by %s", measured 2 int regs,
    // prototype verified (CBaseEntity* other). No named CBaseEntity::Blocked record in the dump.
    "Blocked": {
      "linuxsteamrt64": {
        "module": "libserver.so",
        "pattern": "55 48 89 E5 41 55 41 54 4C 8D AD C0 FE FF FF 49 89 F4 53 48 89 FB 48 81 EC 28 01 00 00",
        "resolve": "direct",
        "validate": { "vtable-member": "CFuncPlat" }
      }
    },
    // CCSPlayerPawn::PostThink. Not wiki PlayerPostThink (that name is offset-low-conf).
    // Anchor in the dump: enter_rescue_zone. Pattern includes `cmp byte [rbx+0x15b4], 0`
    // (a pawn field) — uniqueness helper; a schema-offset drift degrades this type.
    "PostThink": {
      "linuxsteamrt64": {
        "module": "libserver.so",
        "pattern": "55 48 89 E5 41 56 41 55 41 54 53 48 89 FB 48 83 EC 10 E8 ? ? ? ? 80 BB B4 15 00 00 00",
        "resolve": "direct",
        "validate": { "vtable-member": "CCSPlayerPawn" }
      }
    }
  }
}
