+	// Host unloader: stop new registrations and join every outstanding id.
+	// Idle notification is armed separately so a synchronous pending-insert
+	// cancel during construction cannot delete Unloader from its constructor.
+	void BeginRetirement(void (*idle_fn)(void*), void* idle_ctx) {
+		std::vector<KHook::HookID_t> live;
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			m_retiring = true;
+			m_idle_fn = idle_fn;
+			m_idle_ctx = idle_ctx;
+			for (auto& pair : m_ids) {
+				if (pair.second.state == IdState::Registered) {
+					live.push_back(pair.first);
+				}
+			}
+		}
+		for (auto id : live) {
+			RemoveHook(id, true, nullptr, nullptr);
+		}
+	}
+
+	void EnableIdleNotification() {
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			m_idle_enabled = true;
+		}
+		maybe_notify_idle();
+	}
+
+private:
+	KHook::HookID_t adopt_id(KHook::HookID_t id, void* context, void* removed_function) {
+		if (id == KHook::INVALID_HOOK) {
+			return id;
+		}
+
+		bool drop = false;
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			if (m_retiring) {
+				drop = true;
+			} else {
+				IdRecord rec;
+				rec.state = IdState::Registered;
+				rec.hook_context = context;
+				rec.removed_function = removed_function;
+				m_ids.emplace(id, std::move(rec));
+			}
+		}
+
+		if (drop) {
+			KHook::RemoveHook(id, true, nullptr, nullptr);
+			return KHook::INVALID_HOOK;
+		}
+		return id;
+	}
+
+	static void BackendComplete(KHook::HookID_t id, void* context) {
+		static_cast<KHookImpl*>(context)->finish_backend(id);
+	}
+
+	void finish_backend(KHook::HookID_t id) {
+		std::vector<CompletionWaiter> waiters;
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			auto it = m_ids.find(id);
+			if (it != m_ids.end()) {
+				it->second.state = IdState::Completed;
+				waiters.swap(it->second.waiters);
+			}
+			++m_in_flight;
+		}
+
+		for (const auto& waiter : waiters) {
+			if (waiter.fn) {
+				waiter.fn(id, waiter.context);
+			}
+		}
+
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			--m_in_flight;
+		}
+		maybe_notify_idle();
+	}
+
+	void maybe_notify_idle() {
+		void (*fn)(void*) = nullptr;
+		void* ctx = nullptr;
+		{
+			std::lock_guard<std::mutex> guard(m_mutex);
+			if (!m_retiring || !m_idle_enabled || m_idle_notified || m_in_flight != 0) {
+				return;
+			}
+			for (const auto& pair : m_ids) {
+				if (pair.second.state != IdState::Completed) {
+					return;
+				}
+			}
+			m_idle_notified = true;
+			fn = m_idle_fn;
+			ctx = m_idle_ctx;
+		}
+		if (fn) {
+			fn(ctx);
+		}
+	}
+
+	mutable std::mutex m_mutex;
+	std::unordered_map<KHook::HookID_t, IdRecord> m_ids;
+	bool m_retiring = false;
+	bool m_idle_enabled = false;
+	bool m_idle_notified = false;
+	int m_in_flight = 0;
+	void (*m_idle_fn)(void*) = nullptr;
+	void* m_idle_ctx = nullptr;
+};
