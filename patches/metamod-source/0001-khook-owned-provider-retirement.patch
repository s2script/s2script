+ * 2. Altered source versions must be plainly marked as such, and must not be
+ * misrepresented as being the original software.
+ * 3. This notice may not be removed or altered from any source distribution.
+ *
+ * Version: $Id$
+ */
+#pragma once
+
+#include "metamod_khook.h"
+#include "metamod_oslink.h"
+
+#include <memory>
+#include <mutex>
+#include <utility>
+
+/**
+ * Host unloader. Joins KHookImpl-owned retirement instead of copying a stale
+ * id set and calling the low-level backend a second time. The provider is
+ * retained through dlclose so plugin static destructors can still use IKHook.
+ *
+ * Internal test header: the engine-free host lifetime harness compiles this
+ * production type with an injected backend (see KHOOK_STANDALONE forwards).
+ */
+class Unloader {
+public:
+	Unloader(HINSTANCE module, std::shared_ptr<KHookImpl> provider)
+		: _lib(module), _provider(std::move(provider))
+	{
+		if (_provider) {
+			_provider->BeginRetirement(&Unloader::OnIdle, this);
+		}
+	}
+
+	void Check() {
+		if (_provider) {
+			_provider->EnableIdleNotification();
+			return;
+		}
+		Finish();
+	}
+
+private:
+	static void OnIdle(void* context) {
+		static_cast<Unloader*>(context)->Finish();
+	}
+
+	void Finish() {
+		std::shared_ptr<KHookImpl> provider;
+		HINSTANCE lib = nullptr;
+		{
+			std::lock_guard<std::mutex> guard(_mutex);
+			if (_finished) {
+				return;
+			}
+			_finished = true;
+			provider = std::move(_provider);
+			lib = _lib;
+			_lib = nullptr;
+		}
+
+		// dlclose while the provider is still retained. Never hold
+		// bookkeeping locks across this call.
+		if (lib) {
+			dlclose(lib);
+		}
+		provider.reset();
+		delete this;
+	}
+
+	std::mutex _mutex;
+	HINSTANCE _lib;
+	std::shared_ptr<KHookImpl> _provider;
+	bool _finished = false;
+};
+
+inline void RetireHostKHookProvider(HINSTANCE lib, std::shared_ptr<KHookImpl> provider)
+{
+	auto unloader = new Unloader(lib, std::move(provider));
+	unloader->Check();
+}
