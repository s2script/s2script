					</Panel>
					<Panel id="gk_sum_tr4" class="gk-tr s2-hide">
						<Label id="gk_sum_tr4_c0" class="gk-td gk-col0 s2-hide" text="{s:gk_sum_tr4_c0}" />
						<Label id="gk_sum_tr4_c1" class="gk-td gk-col1 s2-hide" text="{s:gk_sum_tr4_c1}" />
						<Label id="gk_sum_tr4_c2" class="gk-td gk-col2 s2-hide" text="{s:gk_sum_tr4_c2}" />
						<Label id="gk_sum_tr4_c3" class="gk-td gk-col3 s2-hide" text="{s:gk_sum_tr4_c3}" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
