<!--
  s2script game kit: in-round HUD (top rail, kill feed, status card, weapon card, toast). Workshop addon 3790153369 (with s2script_lib.xml).

  GENERATED by scripts/gen-gamehud-layout.mjs. Do not edit by hand: change the generator and run it.

  Driven by the server with two levers only: classes (s2-hide, s2-w0..s2-w10 meter steps,
  gk-theme-*, gk-t-*/gk-f-*/gk-e-* tones, gk-sel/gk-on/s2-btn-disabled state) and {s:} dialog
  variables whose names equal their panel ids. No <scripts> and no event attributes: Valve's
  custom_hud_layout contract supports neither. The root Panel may not carry an id, so the theme
  class lives on gk_theme, its first child. The full id list is in s2script_gamekit.manifest.json.
-->
<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/s2script_gamekit.css" />
	</styles>
	<Panel class="gk-root">
		<Panel id="gk_theme" class="gk-theme gk-theme-amber">
			<!-- Top rail: two score blocks around a clock, and a round line. The side tone (gk-e-*) is a class on gk_rail_l / gk_rail_r. -->
			<Panel id="gk_rail" class="gk-rail s2-hide">
				<Panel class="gk-rail-row">
					<Panel id="gk_rail_l" class="gk-side gk-side-l gk-e-blue">
						<Label id="gk_rail_lscore" class="gk-score" text="{s:gk_rail_lscore}" />
						<Label id="gk_rail_llab" class="gk-side-lab" text="{s:gk_rail_llab}" />
						<Panel class="gk-pips">
							<Panel id="gk_rail_lp0" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp1" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp2" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp3" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp4" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp5" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp6" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp7" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp8" class="gk-pip s2-hide" />
							<Panel id="gk_rail_lp9" class="gk-pip s2-hide" />
						</Panel>
					</Panel>
					<Label id="gk_rail_clock" class="gk-clock" text="{s:gk_rail_clock}" />
					<Panel id="gk_rail_r" class="gk-side gk-side-r gk-e-blue">
						<Panel class="gk-pips">
							<Panel id="gk_rail_rp0" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp1" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp2" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp3" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp4" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp5" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp6" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp7" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp8" class="gk-pip s2-hide" />
							<Panel id="gk_rail_rp9" class="gk-pip s2-hide" />
						</Panel>
						<Label id="gk_rail_rlab" class="gk-side-lab" text="{s:gk_rail_rlab}" />
						<Label id="gk_rail_rscore" class="gk-score" text="{s:gk_rail_rscore}" />
					</Panel>
				</Panel>
				<Label id="gk_rail_sub" class="gk-rail-sub" text="{s:gk_rail_sub}" />
			</Panel>
			<!-- Kill feed: rows only as wide as their content, right-aligned. The runtime rotates which row is newest. -->
			<Panel id="gk_feed" class="gk-feed">
				<Panel id="gk_kf0" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf0_tag" class="gk-kill-tag" text="{s:gk_kf0_tag}" />
					<Label id="gk_kf0_a" class="gk-kill-name" text="{s:gk_kf0_a}" />
					<Image id="gk_kf0_wi" class="gk-kill-icon" src="{s:gk_kf0_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf0_w" class="gk-kill-wtext" text="{s:gk_kf0_w}" />
					<Panel id="gk_kf0_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf0_v" class="gk-kill-name" text="{s:gk_kf0_v}" />
				</Panel>
				<Panel id="gk_kf1" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf1_tag" class="gk-kill-tag" text="{s:gk_kf1_tag}" />
					<Label id="gk_kf1_a" class="gk-kill-name" text="{s:gk_kf1_a}" />
					<Image id="gk_kf1_wi" class="gk-kill-icon" src="{s:gk_kf1_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf1_w" class="gk-kill-wtext" text="{s:gk_kf1_w}" />
					<Panel id="gk_kf1_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf1_v" class="gk-kill-name" text="{s:gk_kf1_v}" />
				</Panel>
				<Panel id="gk_kf2" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf2_tag" class="gk-kill-tag" text="{s:gk_kf2_tag}" />
					<Label id="gk_kf2_a" class="gk-kill-name" text="{s:gk_kf2_a}" />
					<Image id="gk_kf2_wi" class="gk-kill-icon" src="{s:gk_kf2_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf2_w" class="gk-kill-wtext" text="{s:gk_kf2_w}" />
					<Panel id="gk_kf2_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf2_v" class="gk-kill-name" text="{s:gk_kf2_v}" />
				</Panel>
				<Panel id="gk_kf3" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf3_tag" class="gk-kill-tag" text="{s:gk_kf3_tag}" />
					<Label id="gk_kf3_a" class="gk-kill-name" text="{s:gk_kf3_a}" />
					<Image id="gk_kf3_wi" class="gk-kill-icon" src="{s:gk_kf3_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf3_w" class="gk-kill-wtext" text="{s:gk_kf3_w}" />
					<Panel id="gk_kf3_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf3_v" class="gk-kill-name" text="{s:gk_kf3_v}" />
				</Panel>
				<Panel id="gk_kf4" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf4_tag" class="gk-kill-tag" text="{s:gk_kf4_tag}" />
					<Label id="gk_kf4_a" class="gk-kill-name" text="{s:gk_kf4_a}" />
					<Image id="gk_kf4_wi" class="gk-kill-icon" src="{s:gk_kf4_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf4_w" class="gk-kill-wtext" text="{s:gk_kf4_w}" />
					<Panel id="gk_kf4_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf4_v" class="gk-kill-name" text="{s:gk_kf4_v}" />
				</Panel>
				<Panel id="gk_kf5" class="gk-kill gk-e-grey s2-hide">
					<Label id="gk_kf5_tag" class="gk-kill-tag" text="{s:gk_kf5_tag}" />
					<Label id="gk_kf5_a" class="gk-kill-name" text="{s:gk_kf5_a}" />
					<Image id="gk_kf5_wi" class="gk-kill-icon" src="{s:gk_kf5_wi}" scaling="stretch-to-fit-preserve-aspect" />
					<Label id="gk_kf5_w" class="gk-kill-wtext" text="{s:gk_kf5_w}" />
					<Panel id="gk_kf5_hs" class="gk-kill-hs s2-hide" />
					<Label id="gk_kf5_v" class="gk-kill-name" text="{s:gk_kf5_v}" />
				</Panel>
			</Panel>
			<!-- Status card: role, hint and two bars. Bars move in 10% steps (s2-w0..s2-w10). -->
			<Panel id="gk_status" class="gk-panel gk-status s2-hide">
				<Panel class="gk-role-row">
					<Label id="gk_status_role" class="gk-role gk-t-accent" text="{s:gk_status_role}" />
					<Label id="gk_status_hint" class="gk-role-hint" text="{s:gk_status_hint}" />
				</Panel>
				<Panel id="gk_bar0" class="gk-bar-row">
					<Label id="gk_bar0_lab" class="gk-bar-lab" text="{s:gk_bar0_lab}" />
					<Panel class="gk-bar">
						<Panel id="gk_bar0_fill" class="gk-bar-fill gk-f-green s2-w0" />
					</Panel>
					<Label id="gk_bar0_val" class="gk-bar-val" text="{s:gk_bar0_val}" />
				</Panel>
				<Panel id="gk_bar1" class="gk-bar-row">
					<Label id="gk_bar1_lab" class="gk-bar-lab" text="{s:gk_bar1_lab}" />
					<Panel class="gk-bar">
						<Panel id="gk_bar1_fill" class="gk-bar-fill gk-f-blue s2-w0" />
					</Panel>
					<Label id="gk_bar1_val" class="gk-bar-val" text="{s:gk_bar1_val}" />
				</Panel>
			</Panel>
			<!-- Weapon card: replaces the stock weapons HUD (m_iHideHUD bit 6). Bottom right, clear of chat (left) and the kill feed (top right).
       A compact slot list, then the active weapon's name (or grenade count) and clip / reserve. -->
			<Panel id="gk_wpn" class="gk-panel gk-wpn s2-hide">
				<Panel id="gk_wpn_slots" class="gk-wpn-slots s2-hide">
					<Panel id="gk_wpn_s0" class="gk-wslot s2-hide">
						<Label class="gk-wslot-k" text="1" />
						<Label id="gk_wpn_s0_t" class="gk-wslot-t" text="{s:gk_wpn_s0_t}" />
					</Panel>
					<Panel id="gk_wpn_s1" class="gk-wslot s2-hide">
						<Label class="gk-wslot-k" text="2" />
						<Label id="gk_wpn_s1_t" class="gk-wslot-t" text="{s:gk_wpn_s1_t}" />
					</Panel>
					<Panel id="gk_wpn_s2" class="gk-wslot s2-hide">
						<Label class="gk-wslot-k" text="3" />
						<Label id="gk_wpn_s2_t" class="gk-wslot-t" text="{s:gk_wpn_s2_t}" />
					</Panel>
					<Panel id="gk_wpn_s3" class="gk-wslot s2-hide">
						<Label class="gk-wslot-k" text="4" />
						<Label id="gk_wpn_s3_t" class="gk-wslot-t" text="{s:gk_wpn_s3_t}" />
					</Panel>
					<Panel id="gk_wpn_s4" class="gk-wslot s2-hide">
						<Label class="gk-wslot-k" text="5" />
						<Label id="gk_wpn_s4_t" class="gk-wslot-t" text="{s:gk_wpn_s4_t}" />
					</Panel>
				</Panel>
				<Panel class="gk-wpn-hd">
					<Label id="gk_wpn_name" class="gk-wpn-name" text="{s:gk_wpn_name}" />
					<Label id="gk_wpn_count" class="gk-wpn-count s2-hide" text="{s:gk_wpn_count}" />
				</Panel>
				<Panel id="gk_wpn_ammo" class="gk-wpn-ammo s2-hide">
					<Label id="gk_wpn_clip" class="gk-wpn-clip" text="{s:gk_wpn_clip}" />
					<Label id="gk_wpn_res" class="gk-wpn-res" text="{s:gk_wpn_res}" />
				</Panel>
			</Panel>
			<!-- Toast: one line and a small subline, top centre. -->
			<Panel id="gk_toast" class="gk-toast s2-hide">
				<Label id="gk_toast_t" class="gk-toast-t" text="{s:gk_toast_t}" />
				<Label id="gk_toast_s" class="gk-toast-s" text="{s:gk_toast_s}" />
			</Panel>
			<!-- Round-end summary: who won, why, a few headline stats and a short table. Passive: no cursor. -->
			<Panel id="gk_sum" class="gk-panel gk-sum gk-e-accent s2-hide">
				<Label id="gk_sum_eye" class="gk-eyebrow gk-t-accent" text="{s:gk_sum_eye}" />
				<Label id="gk_sum_t" class="gk-sum-t gk-t-accent" text="{s:gk_sum_t}" />
				<Label id="gk_sum_s" class="gk-sum-s" text="{s:gk_sum_s}" />
				<Panel class="gk-kv gk-sum-kv">
					<Panel id="gk_sum_kv0" class="gk-kv-cell s2-hide">
						<Label id="gk_sum_kv0_k" class="gk-kv-k" text="{s:gk_sum_kv0_k}" />
						<Label id="gk_sum_kv0_v" class="gk-kv-v" text="{s:gk_sum_kv0_v}" />
					</Panel>
					<Panel id="gk_sum_kv1" class="gk-kv-cell s2-hide">
						<Label id="gk_sum_kv1_k" class="gk-kv-k" text="{s:gk_sum_kv1_k}" />
						<Label id="gk_sum_kv1_v" class="gk-kv-v" text="{s:gk_sum_kv1_v}" />
					</Panel>
					<Panel id="gk_sum_kv2" class="gk-kv-cell s2-hide">
						<Label id="gk_sum_kv2_k" class="gk-kv-k" text="{s:gk_sum_kv2_k}" />
						<Label id="gk_sum_kv2_v" class="gk-kv-v" text="{s:gk_sum_kv2_v}" />
					</Panel>
					<Panel id="gk_sum_kv3" class="gk-kv-cell s2-hide">
						<Label id="gk_sum_kv3_k" class="gk-kv-k" text="{s:gk_sum_kv3_k}" />
						<Label id="gk_sum_kv3_v" class="gk-kv-v" text="{s:gk_sum_kv3_v}" />
					</Panel>
				</Panel>
				<Panel id="gk_sum_table" class="gk-sum-table s2-hide">
					<Panel class="gk-tr gk-th">
						<Label id="gk_sum_th0" class="gk-td gk-col0 s2-hide" text="{s:gk_sum_th0}" />
						<Label id="gk_sum_th1" class="gk-td gk-col1 s2-hide" text="{s:gk_sum_th1}" />
						<Label id="gk_sum_th2" class="gk-td gk-col2 s2-hide" text="{s:gk_sum_th2}" />
						<Label id="gk_sum_th3" class="gk-td gk-col3 s2-hide" text="{s:gk_sum_th3}" />
					</Panel>
					<Panel id="gk_sum_tr0" class="gk-tr s2-hide">
						<Label id="gk_sum_tr0_c0" class="gk-td gk-col0 s2-hide" text="{s:gk_sum_tr0_c0}" />
						<Label id="gk_sum_tr0_c1" class="gk-td gk-col1 s2-hide" text="{s:gk_sum_tr0_c1}" />
						<Label id="gk_sum_tr0_c2" class="gk-td gk-col2 s2-hide" text="{s:gk_sum_tr0_c2}" />
						<Label id="gk_sum_tr0_c3" class="gk-td gk-col3 s2-hide" text="{s:gk_sum_tr0_c3}" />
					</Panel>
					<Panel id="gk_sum_tr1" class="gk-tr s2-hide">
						<Label id="gk_sum_tr1_c0" class="gk-td gk-col0 s2-hide" text="{s:gk_sum_tr1_c0}" />
						<Label id="gk_sum_tr1_c1" class="gk-td gk-col1 s2-hide" text="{s:gk_sum_tr1_c1}" />
						<Label id="gk_sum_tr1_c2" class="gk-td gk-col2 s2-hide" text="{s:gk_sum_tr1_c2}" />
						<Label id="gk_sum_tr1_c3" class="gk-td gk-col3 s2-hide" text="{s:gk_sum_tr1_c3}" />
					</Panel>
					<Panel id="gk_sum_tr2" class="gk-tr s2-hide">
						<Label id="gk_sum_tr2_c0" class="gk-td gk-col0 s2-hide" text="{s:gk_sum_tr2_c0}" />
						<Label id="gk_sum_tr2_c1" class="gk-td gk-col1 s2-hide" text="{s:gk_sum_tr2_c1}" />
						<Label id="gk_sum_tr2_c2" class="gk-td gk-col2 s2-hide" text="{s:gk_sum_tr2_c2}" />
