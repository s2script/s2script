{
  "schemaVersion": 2,
  "functions": {
    // Observe the package's HUD input-capture setter (same target as games/cs2 gamedata).
    "captureProbe": {
      "target": {
        "module": "libserver.so",
        "pattern": "55 48 89 E5 41 55 41 54 53 48 63 DE 48 83 EC ? 85 DB 78 0B 49 89 FC 39 9F ? ? ? ? 7F 11 48 83 C4 ?",
        "validate": { "prologue": "55 48 89 E5 41 55 41 54 53 48 63 DE" }
      },
      "receiver": { "type": "entity" },
      "parameters": [
        { "name": "slot", "type": "i32" },
        { "name": "enabled", "type": "bool" }
      ],
      "returns": "void",
      "surfaces": ["pre"],
      "suppression": "none"
    }
  }
}
