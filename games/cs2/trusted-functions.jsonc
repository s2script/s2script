            "ownership": "invocation-passthrough", "mutable": [], "nullable": false },
          { "name": "player", "native": "ptr", "projection": { "id": "entity?", "version": 1 },
            "mutable": [], "nullable": false },
          { "name": "layout", "native": "ptr", "projection": { "id": "native-only", "version": 1 },
            "ownership": "invocation-passthrough", "mutable": [], "nullable": false },
          { "name": "buttonId", "native": "ptr", "projection": { "id": "string-indirect", "version": 1 },
            "ownership": "native-observed", "mutable": [], "nullable": false }
        ],
        "returns": { "name": "", "native": "void", "projection": { "id": "void", "version": 1 },
          "mutable": [], "nullable": false },
