// Trusted engine functions of the @s2script/cs2 package — host-verified declarations that only a
// selected first-party package may make (hidden native positions, borrowed records, scratch
// slots, copied string-indirect text). Community plugins never reach this grammar.
//
// LAYOUT IS DATA HERE, SEMANTICS ARE THE ADAPTERS. Each function names its gamedata signature BY
// NAME: the host fills the resolved target from the MERGED shipped + operator-custom gamedata at
// package commit, so a `gamedata/cs2/custom/` signature repair keeps working and is recorded as
// provenance. Record field offsets are named by offset key and resolved at commit against the
// LIVE schema (falling back to the schema catalog this package was built from). The builder
// (scripts/build-game-packages.mjs) seals fingerprints, stack sizes, policy and adapter contract
// hashes; the fold/timing semantics live in js/adapters/*.js.
{
  "schemaVersion": 1,
  "offsets": {
    "CEconItemView::m_iItemDefinitionIndex": { "class": "CEconItemView", "field": "m_iItemDefinitionIndex" },
    "CTakeDamageInfo::m_hInflictor": { "class": "CTakeDamageInfo", "field": "m_hInflictor" },
    "CTakeDamageInfo::m_hAttacker": { "class": "CTakeDamageInfo", "field": "m_hAttacker" },
    "CTakeDamageInfo::m_flDamage": { "class": "CTakeDamageInfo", "field": "m_flDamage" },
    "CTakeDamageInfo::m_bitsDamageType": { "class": "CTakeDamageInfo", "field": "m_bitsDamageType" },
    // CMoveData is not a schema class: these name the package gamedata offsets, plus a byte delta
    // for each vector component.
    "CMoveData::m_vecViewAngles.x": { "gamedata": "CMoveData_m_vecViewAngles" },
    "CMoveData::m_vecViewAngles.y": { "gamedata": "CMoveData_m_vecViewAngles", "delta": 4 },
    "CMoveData::m_vecViewAngles.z": { "gamedata": "CMoveData_m_vecViewAngles", "delta": 8 },
    "CMoveData::m_flForwardMove": { "gamedata": "CMoveData_m_flForwardMove" },
    "CMoveData::m_flSideMove": { "gamedata": "CMoveData_m_flSideMove" },
    "CMoveData::m_vecVelocity.x": { "gamedata": "CMoveData_m_vecVelocity" },
    "CMoveData::m_vecVelocity.y": { "gamedata": "CMoveData_m_vecVelocity", "delta": 4 },
    "CMoveData::m_vecVelocity.z": { "gamedata": "CMoveData_m_vecVelocity", "delta": 8 },
    "CMoveData::m_vecAbsOrigin.x": { "gamedata": "CMoveData_m_vecAbsOrigin" },
    "CMoveData::m_vecAbsOrigin.y": { "gamedata": "CMoveData_m_vecAbsOrigin", "delta": 4 },
    "CMoveData::m_vecAbsOrigin.z": { "gamedata": "CMoveData_m_vecAbsOrigin", "delta": 8 }
  },
  "functions": [
    // CCSPlayer_ItemServices::CanAcquire(ItemServices* this, CEconItemView* item, int method,
    // void* unknown) -> AcquireResult. rdi/rsi/edx/rcx per the signature's prologue
    // (mov rbx,rdi; mov r14,rsi; [rbp-0x44]=edx; mov r12,rcx). The receiver is NOT an entity: it
    // stays native-only and the adapter maps it to a player with hiddenReferencedBy. `result` is a
    // per-dispatch scratch vote, never written to native memory.
    {
      "localName": "canAcquire",
      "requirement": "optional",
      "signatureName": "CCSPlayer_ItemServices_CanAcquire",
      "signature": {
        "platform": "linux-x86_64-sysv",
        "memberReceiver": false,
        "receiver": null,
        "parameters": [
          { "name": "itemServices", "native": "ptr", "projection": { "id": "native-only", "version": 1 },
            "ownership": "invocation-passthrough", "mutable": [], "nullable": false },
          { "name": "item", "native": "ptr", "projection": { "id": "borrowed-record", "version": 1 },
            "ownership": "synchronous-record", "mutable": [], "instance": 0, "nullable": false },
          { "name": "method", "native": "i32", "projection": { "id": "i32", "version": 1 },
            "mutable": [], "nullable": false },
          { "name": "unknown", "native": "ptr", "projection": { "id": "native-only", "version": 1 },
            "ownership": "invocation-passthrough", "mutable": [], "nullable": false }
        ],
        "returns": { "name": "", "native": "i32", "projection": { "id": "i32", "version": 1 },
          "mutable": [], "nullable": false },
        "instances": [
          { "codecId": "borrowed-record", "codecVersion": 1, "kind": null,
            "record": { "fields": [
              { "name": "defIndex", "offsetKey": "CEconItemView::m_iItemDefinitionIndex", "storage": "u16",
                "nullable": false, "read": ["pre", "post"], "write": [] }
            ] } }
        ],
        "scratch": [{ "name": "result", "storage": "i32" }]
      },
      "policy": { "surfaces": ["pre", "post"], "suppression": "generic" },
      "adapter": { "id": "legacy.acquire.v1", "postOverride": true }
    },
    // CCSCustomHudLayout CustomHudClickedReceiver(?, CCSPlayerController* clicker, layout*,
